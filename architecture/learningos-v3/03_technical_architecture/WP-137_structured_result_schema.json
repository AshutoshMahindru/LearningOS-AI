{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.ai/schemas/structured_result.v1.json",
  "title": "LearningOS Structured Result Schema v1",
  "type": "object",
  "required": ["execution_id", "status", "exit_code", "duration_ms", "blocks"],
  "properties": {
    "execution_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "TIMEOUT", "CRASHED"]
    },
    "exit_code": { "type": "integer" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "payload"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["table", "chart", "trace", "state_diff", "diagram", "markdown", "metric", "artifact"]
          },
          "title": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "system_metrics": {
          "type": "object",
          "properties": {
            "memory_peak_mb": { "type": "number" },
            "cpu_time_ms": { "type": "number" }
          }
        }
      }
    }
  }
}
