{"cells":[{"cell_type":"markdown","metadata":{},"source":["# M03 — Modify Python Before Learning Python\n","Start with a working program, modify it, debug it, and explain behavior changes."]},{"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["def order_total(items, discount=0):\n","    total = sum(items)\n","    if discount:\n","        total -= discount\n","    return total\n","\n","print(order_total([10,20,30]))\n"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}